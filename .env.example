# ==============================================================================
# SEO OS AI Workbench — Environment Configuration
# Copy to .env (never commit real secrets).
# ==============================================================================

# Server & Runtime
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/seo-os-workbench.sqlite

# Cryptographic Keys (generate random 32-byte hex values in production)
SESSION_SECRET=dev-session-secret-replace-in-production-64-hex-chars
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Payment Provider ("test" for built-in test mode, "stripe" for live Stripe Checkout)
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=whsec_test_seo_os_workbench_local_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SETUP_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=

# Optional Live Model & SEO Providers (leave empty to use clearly-labeled typed mock adapters)
MODEL_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GA4_PROPERTY_ID=
SERP_API_KEY=

# Frontend Static GitHub Pages Mode (set true only for static GitHub Pages builds)
VITE_STATIC_DEMO_MODE=false
