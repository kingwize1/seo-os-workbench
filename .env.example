# ==============================================================================
# SEO OS AI Workbench — Environment Configuration Template
# Copy to .env and fill in values (NEVER commit real secrets to Git).
# ==============================================================================

# Core Server & Cryptographic Keys
PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/seo-os-workbench.sqlite
SESSION_SECRET=replace-with-64-char-random-hex
SECRETS_ENCRYPTION_KEY=replace-with-64-char-random-hex

# Billing ("test" for built-in test mode, "stripe" for live Stripe Checkout)
PAYMENT_PROVIDER=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=whsec_test_seo_os_workbench_local_secret
STRIPE_SETUP_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=

# Personal Agent Waitlist Approver Email
WAITLIST_APPROVER_EMAIL=kingwizemusic@gmail.com
RESEND_API_KEY=
EMAIL_FROM=SEO OS Waitlist <onboarding@resend.dev>

# Google OAuth Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Live Model Providers (leave empty to use clearly-labeled mock adapters)
MODEL_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.b.ai
ANTHROPIC_MODEL=claude-sonnet-4-6
API_TIMEOUT_MS=3000000
HUGGINGFACE_API_KEY=

# Optional Live SEO, Crawl, Maps & Intent Providers
DATAFORSEO_EMAIL=
DATAFORSEO_PASSWORD=
APIFY_API_KEY=
CRAWLER_DEV_API_KEY=
GOOGLE_MAPS_API_KEY=
INTENTGPT_API_KEY=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GA4_PROPERTY_ID=

# Optional Avatar, Voice Clone & Approval-Gated Social Providers
LONGCAT_API_KEY=
LONGCAT_REPO_URL=https://github.com/meituan-longcat/LongCat-Video
OPENHOME_API_KEY=
ZERNIO_API_KEY=

# Frontend Static GitHub Pages Mode (true only for static GitHub Pages builds)
VITE_STATIC_DEMO_MODE=false
